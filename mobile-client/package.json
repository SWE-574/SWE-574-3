{
  "name": "the-hive",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --clear",
    "ios": "EXPO_PUBLIC_API_URL=http://localhost:8000/api expo run:ios",
    "android": "EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api expo run:android",
    "device": "expo start --clear --host lan",
    "prebuild": "expo prebuild --clean",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@getlimelight/sdk": "^0.7.10",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "^5.2.0",
    "@react-navigation/bottom-tabs": "^7.15.3",
    "@react-navigation/native": "^7.1.31",
    "@react-navigation/native-stack": "^7.14.4",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-webview": "13.15.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "fast-uri": "^3.1.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "api",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/src/api"
        ],
        "testMatch": [
          "**/__tests__/**/*.test.ts"
        ],
        "moduleNameMapper": {
          "^expo-secure-store$": "<rootDir>/src/api/__tests__/__mocks__/expo-secure-store.ts",
          "^expo-network$": "<rootDir>/src/api/__tests__/__mocks__/expo-network.ts"
        }
      },
      {
        "displayName": "components",
        "preset": "jest-expo",
        "setupFiles": [
          "<rootDir>/src/__tests__/setup.ts"
        ],
        "roots": [
          "<rootDir>/src"
        ],
        "testMatch": [
          "**/components/__tests__/**/*.test.tsx",
          "**/__tests__/components/**/*.test.tsx"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native|@react-navigation|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-clone-referenced-element|@react-native-community|sentry-expo|native-base|react-native-svg))"
        ]
      }
    ]
  },
  "private": true
}
